# inni 설정. cp .env.example .env 로 복사해서 채운다. .env 는 git 에 올리지 않는다.

# --- 로그인(Firebase 구글) — docs/firebase-setup.md 참고 ---
# Firebase 콘솔 → 프로젝트 설정 → 일반 → 내 앱(웹)
FIREBASE_PROJECT_ID=my-school-inni
FIREBASE_API_KEY=AIzaSy...
# 비우면 ${FIREBASE_PROJECT_ID}.firebaseapp.com
FIREBASE_AUTH_DOMAIN=

# 처음 관리자(쉼표로 여러 명). 이 계정은 승인 없이 바로 관리자로 들어온다
ADMIN_EMAILS=you@your-school.hs.kr

# 로그인할 수 있는 학교 도메인(쉼표). 비우면 어떤 메일이든 들어오되 "승인 대기"로 들어온다
# 예: sen.go.kr,hanbit.hs.kr   (교육청 메일·학교 구글 워크스페이스 도메인)
ALLOWED_DOMAINS=

# 로그인 방법(쉼표): google = 구글 계정 팝업, email = 학교 메일로 받은 링크(구글 계정이 아닌 교육청 메일도 됨)
# Firebase 콘솔에서 켠 방법과 맞추기
LOGIN_METHODS=google,email

# --- 화면·주소 ---
SCHOOL_NAME=우리 학교
# 라벨 QR 에 들어갈 주소. 비우면 접속한 주소를 쓴다. 역방향 프록시(https)를 쓰면 그 주소로
PUBLIC_URL=
# NAS 에서 열 포트(겹치면 바꾸기)
INNI_PORT=8080

# --- 기타 ---
TZ=Asia/Seoul
SESSION_DAYS=30
# 로그인 없이 화면만 둘러보기(시연용): AUTH_MODE=dev, SEED_DEMO=1 — 운영에서는 절대 쓰지 말 것
AUTH_MODE=firebase
SEED_DEMO=0
